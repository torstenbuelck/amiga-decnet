; DECnet-Start - set up DECnet and start dnetd (AmigaOS 2.04+)
; Usage: Execute DECnet:S/DECnet-Start [ADDR=area.node] [UNIT=n] [DEVICE=name]
; The defaults above were written by the installer. S:User-Startup runs
; this script; it must run before AmiTCP or any other network software,
; because only the first program that configures the card sets its
; station address. dnetd log: T:dnetd.log

; the commands, in the path of the Shell running this script (the path
; belongs to that Shell, so check every time; at boot Workbench inherits it)
Which >NIL: dnetd
If WARN
  Path DECnet:C ADD
EndIf

; once per boot: node names
If NOT EXISTS ENV:DECnet/setup-done
  If NOT EXISTS ENV:DECnet
    MakeDir ENV:DECnet
  EndIf
  If NOT EXISTS ENV:DECnet/nodes
    If EXISTS ENVARC:DECnet/nodes
      Copy ENVARC:DECnet/nodes ENV:DECnet/nodes QUIET
    EndIf
  EndIf
  Echo >ENV:DECnet/setup-done "1"
EndIf

dnetd >NIL: CHECK
If WARN
  ; started by its bare name, found through the path
  Run >NIL: dnetd ADDR={ADDR} UNIT={UNIT} DEVICE={DEVICE} LOG=T:dnetd.log
  ; give it time to open the device, then ask whether it runs (Run
  ; >NIL: hides every error, e.g. a wrong device or unit)
  ; (each If tests the command right before it: EndIf resets the RC)
  Wait 2
  dnetd >NIL: CHECK
  If WARN
    Wait 3
    dnetd >NIL: CHECK
    If WARN
      Echo "dnetd did not start, see T:dnetd.log:"
      If EXISTS T:dnetd.log
        Type T:dnetd.log
      EndIf
      Quit 5
    EndIf
  EndIf
  Echo "DECnet node {ADDR} started (log: T:dnetd.log)"
Else
  Echo "dnetd is already running"
EndIf

; DN: file system (dn-handler), mounted once, after dnetd: a
; failing Mount stops this script
If NOT EXISTS ENV:DECnet/dn-mounted
  Mount DN: FROM DECnet:Storage/Mountlist
  Echo >ENV:DECnet/dn-mounted "1"
EndIf
