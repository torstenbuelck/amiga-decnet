(procedure P_CHECKNAME
	(set #name-ok 0)
	(if (AND (> (strlen #name) 0) (< (strlen #name) 7)
	         (patmatch "#[A-Za-z0-9]" #name)
	         (NOT (patmatch "#[0-9]" #name)))
		(set #name-ok 1)
	)
)

; #val into ENVARC:DECnet/#var and ENV:DECnet/#var (no newline, for getenv)
(procedure P_SAVEVAR
	(textfile (prompt "") (help "") (dest (tackon "ENVARC:DECnet" #var)) (append #val))
	(textfile (prompt "") (help "") (dest (tackon "ENV:DECnet" #var)) (append #val))
)

; ---------------------------------------------------------------- remove

(procedure P_REMOVE
	(set #old (getassign "DECnet"))
	(if (= #old "")
		(set #old (askdir
			(prompt #t-rm-where)
			(help @askdir-help)
			(default "SYS:DECnet")
		))
	)
	(if (NOT (exists (tackon #old "C/dnstartup")))
		(abort "\"" #old #t-rm-nodrawer)
	)
	(if (askbool
		(prompt #t-rm-ask-1 #old #t-rm-ask-2)
		(help #t-rm-help)
		(choices #t-rm-yes #t-cancel)
		(default 0))
		(
			(execute (tackon #old "S/DECnet-Stop"))
			(run (cat "\"" (tackon #old "C/dnstartup") "\" REMOVE"))
			(delete "LIBS:decnet.library" (optional "force") (prompt "") (help ""))
			; only the files DECnet and DECnet-Term installed: the drawer
			; may hold the user's own files (missing files are no error)
			(delete (tackon #old "C/dnetd") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dncheck") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dncopy") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dndir") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dnnodes") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dnstartup") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dntermpatch") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/latd") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "C/dnmaint") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "L/dn-handler") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "S/DECnet-Start") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "S/DECnet-Stop") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "S/DECnet-Start-Term") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "S/DECnet-Stop-Term") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Storage/Mountlist") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/Disk.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/Node.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/Dir.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/Text.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/Picture.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/File.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "Icons/DECnet.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "ReadMe") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "ReadMe.info") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "LiesMich") (optional "force") (prompt "") (help ""))
			(delete (tackon #old "LiesMich.info") (optional "force") (prompt "") (help ""))
			; DECnet-Term: its files in the drawer are gone above
			(delete "DEVS:dnterm.device" (optional "force") (prompt "") (help ""))
			(delete "ENVARC:DECnet/maint-node" (optional "force") (prompt "") (help ""))
			(delete "ENVARC:DECnet/maint-latnodes" (optional "force") (prompt "") (help ""))
			(delete "ENVARC:DECnet/maint-password" (optional "force") (prompt "") (help ""))
			(delete "ENV:DECnet/maint-node" (optional "force") (prompt "") (help ""))
			(delete "ENV:DECnet/maint-latnodes" (optional "force") (prompt "") (help ""))
			(delete "ENV:DECnet/maint-password" (optional "force") (prompt "") (help ""))
			; the drawers only if empty now: AmigaDOS Delete keeps a drawer
			; with files in it, and its error does not stop the Installer
			(run (cat "Delete >NIL: \"" (tackon #old "C") "\""))
			(run (cat "Delete >NIL: \"" (tackon #old "S") "\""))
			(run (cat "Delete >NIL: \"" (tackon #old "L") "\""))
			(run (cat "Delete >NIL: \"" (tackon #old "Storage") "\""))
			(run (cat "Delete >NIL: \"" (tackon #old "Icons") "\""))
			(run (cat "Delete >NIL: \"" #old "\""))
			(set #left "")
			(if (exists #old)
				(set #left (cat #t-rm-left-1 #old #t-rm-left-2))
				(delete (cat #old ".info") (optional "force") (prompt "") (help ""))
			)
			(exit #t-rm-done #left (quiet))
		)
		(exit (quiet))
	)
)

; ---------------------------------------------------------------- install

(procedure P_DEVICE
	; device, unit and the check with dncheck
	(set #again 1)
	(while #again
		(set #device (askfile
			(prompt #t-dev-ask)
			(help #t-dev-help @askfile-help)
			(default #device)
		))
		(if (= @user-level 2)
			(set #device (askstring
				(prompt #t-dev-name)
				(help @askstring-help)
				(default #device)
			))
		)
		(set #unit (asknumber
			(prompt #t-unit)
			(help @asknumber-help)
			(range 0 31)
			(default #unit)
		))

		(message #t-check-1 #addr #t-check-2 (help #t-check-help))
		(set #rc (run (cat "C/dncheck DEVICE=\"" #device "\" UNIT=" #unit " ADDR=" #addr " CLOSEHINT"
		                   " >CON:0/380/640/170/DECnet-Check/CLOSE")))
		(set #again 0)
		(if (= #rc 5)
			(set #again (NOT (askbool
				(prompt #t-rc5)
				(help #t-rc5-help)
				(choices #t-install #t-again)
				(default 0)))
			)
		)
		(if (= #rc 10)
			(set #again (NOT (askbool
				(prompt #t-rc10)
				(help #t-rc10-help)
				(choices #t-anyway #t-again)
				(default 1)))
			)
		)
		(if (>= #rc 20)
			(set #again (NOT (askbool
				(prompt #t-rc20-1 #device #t-rc20-2 #unit #t-rc20-3)
				(help #t-rc20-help)
				(choices #t-anyway #t-again)
				(default 1)))
			)
		)
	)
)

(procedure P_INSTALL
	; ---- where
	(set #target (getassign "DECnet"))
	(set #update (<> #target ""))
	(if (= #target "")
		(
			(set #dest (askdir
				(prompt #t-where)
				(help @askdir-help)
				(default @default-dest)
			))
			(set #target (tackon #dest "DECnet"))
		)
		(message #t-update-1 #target #t-update-2 (help #t-update-help))
	)
	(set @default-dest #target)

	; ---- answers of the last installation, if any. Address and name get a
	; default only when updating (DECnet: assign exists), never on a new
	; installation: a careless click must not put a second node with the same
	; address on the network.
	(set #addr "")
	(set #name "")
	(if #update
		(
		(set #addr (getenv "DECnet/Address"))
		(set #name (getenv "DECnet/Name"))
		)
	)
	(set #device (getenv "DECnet/Device"))
	(if (= #device "") (set #device "DEVS:Networks/a2065.device"))
	(set #unit (getenv "DECnet/Unit"))
	(set #unit (if (= #unit "") 0 (+ 0 #unit)))

	; ---- who am I
	(set #addr-ok 0)
	(while (NOT #addr-ok)
		(set #addr (askstring
			(prompt #t-addr)
			(help #t-addr-help @askstring-help)
			(default #addr)
		))
		(P_CHECKADDR)
		(if (NOT #addr-ok)
			(message "\"" #addr #t-addr-bad)
		)
	)
	(set #name-ok 0)
	(while (NOT #name-ok)
		(set #name (askstring
			(prompt #t-name)
			(help #t-name-help @askstring-help)
			(default #name)
		))
		(P_CHECKNAME)
		(if (NOT #name-ok)
			(message "\"" #name #t-name-bad)
		)
	)

	; ---- card
	(P_DEVICE)

	; ---- files
	(makedir #target (prompt #t-mkdir #target) (help @makedir-help))
	(if (NOT (exists (cat #target ".info")))
		(copyfiles (prompt "") (help "") (source "Icons/DECnet.info") (dest (pathonly #target)))
	)
	(copyfiles
		(prompt #t-cp-icons)
		(help @copyfiles-help)
		(source "Icons")
		(dest (tackon #target "Icons"))
		(pattern "#?.info")
	)
	(copyfiles
		(prompt #t-cp-c)
		(help @copyfiles-help)
		(source "C")
		(dest (tackon #target "C"))
		(all)
	)
	(copyfiles
		(prompt #t-cp-l)
		(help @copyfiles-help)
		(source "L")
		(dest (tackon #target "L"))
		(all)
	)
	(copyfiles
		(prompt #t-cp-mount)
		(help @copyfiles-help)
		(source "Storage")
		(dest (tackon #target "Storage"))
		(pattern "Mountlist")
	)
	(copyfiles
		(prompt #t-cp-stop)
		(help @copyfiles-help)
		(source "S")
		(dest (tackon #target "S"))
		(pattern "DECnet-Stop")
	)
	(textfile
		(prompt #t-wr-start)
		(help @textfile-help)
		(dest (tackon #target "S/DECnet-Start"))
		(append ".key ADDR/K,UNIT/K,DEVICE/K\n.bra {\n.ket }\n"
		        ".def ADDR " #addr "\n.def UNIT " #unit "\n.def DEVICE \"" #device "\"\n")
		(include "S/DECnet-Start.body")
	)
	; the script bit lets the Shell run them by name (DECnet-Stop), without
	; Execute; LhA archives made on other systems carry no protection bits
	(protect (tackon #target "S/DECnet-Start") "+s")
	(protect (tackon #target "S/DECnet-Stop") "+s")
	; both languages: the documentation is short, and either may be wanted
	(copyfiles
		(prompt #t-cp-doc)
		(help @copyfiles-help)
		(source "")
		(dest #target)
		(choices "ReadMe" "LiesMich")
		(infos)
	)
	; the ReadMe in the archive uses More (on every OS); MultiView from OS 3.0
	(if (< (/ (getversion) 65536) 39)
		(
		(tooltype (dest (tackon #target "ReadMe")) (setdefaulttool "SYS:Utilities/More"))
		(tooltype (dest (tackon #target "LiesMich")) (setdefaulttool "SYS:Utilities/More"))
		(tooltype (dest (tackon #target "Icons/Text")) (setdefaulttool "SYS:Utilities/More"))
		)
		(
		(tooltype (dest (tackon #target "ReadMe")) (setdefaulttool "MultiView"))
		(tooltype (dest (tackon #target "LiesMich")) (setdefaulttool "MultiView"))
		)
	)
	(copylib
		(prompt #t-cp-lib)
		(help @copylib-help)
		(source "Libs/decnet.library")
		(dest "LIBS:")
		(confirm)
	)

	; ---- node list
	(makedir "ENVARC:DECnet" (prompt "") (help ""))
	(if (exists "ENVARC:DECnet/nodes")
		(message #t-nodes-kept (help #t-nodes-kept-help))
		(
		(set #line #name)
		(while (< (strlen #line) 8) (set #line (cat #line " ")))
		(textfile
			(prompt #t-wr-nodes)
			(help @textfile-help)
			(dest "ENVARC:DECnet/nodes")
			(include "Storage/nodes.head")
			(append "\n" #line #addr "\n")
		)
		)
	)
	(makedir "ENV:DECnet" (prompt "") (help ""))
	; in "Pretend to install" the textfile above writes nothing
	(if (exists "ENVARC:DECnet/nodes")
		(copyfiles (prompt "") (help "") (source "ENVARC:DECnet/nodes") (dest "ENV:DECnet"))
	)

	; remember the answers as defaults for the next update
	(set #var "Device") (set #val #device) (P_SAVEVAR)
	(set #var "Unit") (set #val #unit) (P_SAVEVAR)
	(set #var "Address") (set #val #addr) (P_SAVEVAR)
	(set #var "Name") (set #val #name) (P_SAVEVAR)

	; ---- start at boot
	(if (askbool
		(prompt #t-boot)
		(help #t-boot-help-1 #target #t-boot-help-2)
		(choices #t-yes #t-no)
		(default 0))
		(
			(set #rc (run (cat "\"" (tackon #target "C/dnstartup") "\" DIR=\"" #target "\"")
				(prompt #t-boot-run)
				(help @run-help)
			))
			(if (= #rc 5)
				(message #t-boot-warn))
			(if (> #rc 5)
				(message #t-boot-fail-1 #target #t-boot-fail-2))
		)
	)

	; ---- start now (an update restarts the running dnetd, which would
	; otherwise go on with the old version until the next reboot), copy
	; node names
	(makeassign "DECnet" #target)
	(set #running (= 0 (run "DECnet:C/dnetd >NIL: CHECK")))
	(if (askbool
		(prompt (if #running #t-restart #t-start))
		(help #t-start-help)
		(choices (if #running #t-restart-yes #t-start-yes) #t-later)
		(default 0))
		(
			(if #running
				(execute "DECnet:S/DECnet-Stop")
			)
			; DECnet-Start returns 5 (WARN) when dnetd does not run; then
			; asking another node for names makes no sense (kept flat: deep
			; nesting overflows the Installer's stack)
			(set #from "")
			; when pretending, execute is skipped and returns non-zero:
			; no failure message then
			(set #rc (execute "DECnet:S/DECnet-Start"))
			(if (AND (<> #rc 0) (NOT @pretend))
				(message #t-start-fail))
			(if (= #rc 0) (set #from (askstring
				(prompt #t-from)
				(help #t-from-help @askstring-help)
				(default "")
			)))
			(if (<> #from "")
				(
				(working #t-wait)
				(run "Wait 15")
				(run (cat "DECnet:C/dnnodes FROM=" #from " REACHABLE UPDATE"
				          " >CON:0/380/640/170/DECnet-Nodes/CLOSE/WAIT"))
				)
			)
		)
	)

	(exit #t-done-1 #version #t-done-2 #target #t-done-3
	      (tackon #target #t-done-doc) #t-done-4 (quiet))
)

; ---------------------------------------------------------------- main

; The welcome window has room for about six lines above the user level
; choice; longer text runs into it.
(welcome #t-welcome-1 #version #t-welcome-2)

; At novice level the Installer answers every question with its default,
; but the address and name have none. The icon has MINUSER=AVERAGE; from
; the Shell use: Installer Install-DECnet MINUSER AVERAGE
(if (= @user-level 0)
	(abort #t-novice)
)

(if (= 1 (askchoice
	(prompt #t-what)
	(help @askchoice-help)
	(choices #t-what-install #t-what-remove)
	(default 0)))
	(P_REMOVE)
	(P_INSTALL)
)
