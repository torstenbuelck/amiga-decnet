@@ -699,6 +699,11 @@ static void a2065_hsync_handler(void)
 {
 	static int cnt;
 
+	// pcap/TAP backends queue received frames; they must be handed over
+	// from the emulation thread (only sana2.cpp did this, so the card never
+	// received anything)
+	if (td && sysdata)
+		ethernet_receive_poll(td, sysdata);
 	receive_queue_drain();
 
 	cnt--;
@@ -722,6 +727,13 @@ static void chip_init2(void)
 	prom = (am_mode & MODE_PROM) ? 1 : 0;
 	fakeprom = a2065_promiscuous ? 1 : 0;
 
+	// The MAC swapping lets the card share the host's address on pcap.
+	// A TAP device is a port of its own: use the address the driver
+	// programmed, so that e.g. DECnet's AA-00-04-00-xx-xx goes out and
+	// unicasts to it come in unchanged.
+	if (td && td->type == UAENET_TAP)
+		memcpy(realmac, fakemac, sizeof realmac);
+
 	write_log(_T("7990: %04X %06X %d %d %d %d %06X %06X %02X:%02X:%02X:%02X:%02X:%02X\n"),
