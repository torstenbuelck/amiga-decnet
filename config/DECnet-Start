.key ADDR/K,UNIT/K,DEVICE/K
.bra {
.ket }
.def ADDR 23.202
.def UNIT 2
.def DEVICE uaenet.device
; DECnet-Start - set up DECnet and start dnetd (AmigaOS 2.04+)
; Usage: Execute DECnet-Start [ADDR=area.node] [UNIT=n] [DEVICE=name]
; Defaults: AMI 23.202 on uaenet.device unit 2 (Amiberry tap0).
; dnetd log: T:dnetd.log

Assign >NIL: DECnet: Transfer:DECnet

; the commands, in the path of the Shell running this script (the path
; belongs to that Shell, so check every time)
Which >NIL: dnetd
If WARN
  Path DECnet:src/amiga DECnet:src/apps ADD
EndIf
Which >NIL: dnmaint
If WARN
  Path DECnet:src/maint ADD
EndIf

; once per boot: library path, node names
If NOT EXISTS ENV:DECnet/setup-done
  Assign LIBS: DECnet:src/amiga ADD
  If NOT EXISTS ENV:DECnet
    MakeDir ENV:DECnet
  EndIf
  Echo >ENV:DECnet/setup-done "1"
EndIf
Copy DECnet:config/nodes ENV:DECnet/nodes QUIET

dnetd >NIL: CHECK
If WARN
  ; started by its bare name, found through the path
  Run >NIL: dnetd ADDR={ADDR} UNIT={UNIT} DEVICE={DEVICE} LOG=T:dnetd.log
  ; give it time to open the device, then ask whether it runs (Run
  ; >NIL: hides every error, e.g. a wrong device or unit)
  ; (each If tests the command right before it: EndIf resets the RC)
  Wait 2
  dnetd >NIL: CHECK
  If WARN
    Wait 3
    dnetd >NIL: CHECK
    If WARN
      Echo "dnetd did not start, see T:dnetd.log:"
      If EXISTS T:dnetd.log
        Type T:dnetd.log
      EndIf
      Quit 5
    EndIf
  EndIf
  Echo "DECnet node {ADDR} started (log: T:dnetd.log)"
Else
  Echo "dnetd is already running"
EndIf

; the maintenance login (installed: DECnet-Term's DECnet-Start-Term),
; when a password is set
If EXISTS ENV:DECnet/maint-password
  Run >NIL: dnmaint LOG=T:dnmaint.log
EndIf

; DN: file system (dn-handler), mounted once, after dnetd: a
; failing Mount stops this script
If NOT EXISTS ENV:DECnet/dn-mounted
  Mount DN: FROM DECnet:config/Mountlist
  Echo >ENV:DECnet/dn-mounted "1"
EndIf
