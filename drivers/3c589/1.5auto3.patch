-   if((media_status&EL3REG_MEDIAF_BEAT)!=0)
-      link|=EL3REG_CONFIGF_HASTP;
-   LEWordOut(io_base+EL3REG_COMMAND,EL3CMD_SELECTWINDOW|0);
+   if((media&EL3REG_CONFIGF_HASTP)!=0)
