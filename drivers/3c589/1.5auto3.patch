+      media_status=LEWordIn(io_base+EL3REG_MEDIA);
+      LEWordOut(io_base+EL3REG_MEDIA,
+         EL3REG_MEDIAF_BEATENABLE|EL3REG_MEDIAF_JABBERENABLE);
+      GetSysTime(&start);
+      do
+      {
+         BOOL beat=
+            (LEWordIn(io_base+EL3REG_MEDIA)&EL3REG_MEDIAF_BEAT)!=0;
+
+         t=ElapsedMS(&start,base);
+         if(t>=LINK_SETTLE_MS)
+         {
+            if(!beat)
+               in_run=FALSE;
