 *
 */
 
+#define LINK_SETTLE_MS 300   /* ignore BEAT this long after enabling it */
+#define LINK_STABLE_MS 300   /* BEAT must stay set this long */
+#define LINK_PROBE_MS 3000   /* give up after this; a GS305E switch port
+                                gave link pulses only ~950 ms after TP
+                                was selected */
+
+static ULONG ElapsedMS(struct timeval *start,struct DevBase *base)
+{
+   struct timeval now;
+
+   GetSysTime(&now);
+   SubTime(&now,start);
+   /* secs*1000 by shifts, micro/1024 as ms (2.4% short): the 68000
+      build has no 32-bit divide without libgcc */
+   return (now.tv_secs<<10)-(now.tv_secs<<4)-(now.tv_secs<<3)
+      +(now.tv_micro>>10);
+}
+
 static VOID InitialiseAdapter(struct DevUnit *unit,struct DevBase *base)
 {
    volatile UBYTE *io_base;
@@ -662,12 +680,48 @@
 
    /* Get transceivers with an active link */
 
