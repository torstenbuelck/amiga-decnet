+      struct timeval start;
+      ULONG t,run_start=0;
+      BOOL in_run=FALSE;
+
+      /* Select TP with link beat detection. The BEAT bit is already set
+         in the card's power-on state (MEDIA 0x2800 even with only a BNC
+         dongle), so ignore it until the link test has settled, then
+         require it to stay set (link pulses every 16 ms) */
+
+      LEWordOut(io_base+EL3REG_ADDRCONFIG,EL3REG_ADDRCONFIG_XCVRTP);
+      LEWordOut(io_base+EL3REG_COMMAND,EL3CMD_STOPCOAX|0);
