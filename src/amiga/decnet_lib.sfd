==base _DECnetBase
==basetype struct Library *
==libname decnet.library
==bias 30
==public
==include <exec/types.h>
==include <libraries/decnet.h>
struct DnLink * DnConnect(struct DnConnectReq * req) (a0)
LONG DnRead(struct DnLink * link, APTR buffer, LONG length, LONG timeout) (a0,a1,d0,d1)
LONG DnWrite(struct DnLink * link, CONST_APTR buffer, LONG length) (a0,a1,d0)
VOID DnClose(struct DnLink * link) (a0)
LONG DnLinkReason(struct DnLink * link) (a0)
LONG DnNodeAddr(CONST_STRPTR name) (a0)
struct DnListener * DnListen(LONG objnum, CONST_STRPTR objname) (d0,a0)
struct DnLink * DnAccept(struct DnListener * listener, struct DnConnInfo * info, LONG timeout) (a0,a1,d0)
LONG DnAnswer(struct DnLink * link, LONG reason, CONST_APTR data, LONG length) (a0,d0,a1,d1)
VOID DnUnlisten(struct DnListener * listener) (a0)
==end
