struct DnLink * DnConnect(struct DnConnectReq * req) (a0)
LONG DnRead(struct DnLink * link, APTR buffer, LONG length, LONG timeout) (a0,a1,d0,d1)
LONG DnWrite(struct DnLink * link, CONST_APTR buffer, LONG length) (a0,a1,d0)
VOID DnClose(struct DnLink * link) (a0)
LONG DnLinkReason(struct DnLink * link) (a0)
LONG DnNodeAddr(CONST_STRPTR name) (a0)
==end
